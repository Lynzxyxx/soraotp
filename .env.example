NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# URL Realtime Database, contoh: https://soraotp-5555-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Provider OTP
NUSA_BASE_URL=https://nusaotp.site/api
NUSA_API_KEY=
MARKUP_PERCENT=20
RESELLER_MARKUP_PERCENT=8
# Deposit buatqris
BUATQRIS_BASE_URL=https://api.buatqris.site
BUATQRIS_ACCOUNT_ID=
BUATQRIS_SECRET_TOKEN=
# opsional: BUATQRIS_METHOD=qris_two  BUATQRIS_FEE_BY=user  BUATQRIS_TEST=1 (sandbox)
# Email owner pertama (otomatis jadi owner saat buka /admin/soraotp)
OWNER_EMAIL=
# Webhook NusaOTP: set URL https://DOMAIN/api/webhook/nusa?key=<NUSA_WEBHOOK_SECRET> lewat /v2/set-webhook
NUSA_WEBHOOK_SECRET=
# Opsional: tombol Telegram di halaman awal
NEXT_PUBLIC_TELEGRAM_URL=
# Notifikasi Telegram (token dari @BotFather, ID angka akunmu dari @userinfobot; boleh beberapa ID pisah koma)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
# Rekap otomatis harian (Vercel Cron): string acak panjang
CRON_SECRET=
