rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /users/{uid} {
      allow read: if request.auth.uid == uid;
      allow create: if request.auth.uid == uid && request.resource.data.saldo == 0 && !('role' in request.resource.data) && !('blocked' in request.resource.data) && !('saldoFrozen' in request.resource.data);
      allow update: if request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','wa']);
    }
    match /orders/{id} { allow read: if request.auth.uid == resource.data.uid; }
    match /deposits/{id} { allow read: if request.auth.uid == resource.data.uid; }
  }
}
